
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELITE MOTORS | الدراجات النارية</title>
<style>
:root {
  --green: #b7ff00;
  --black: #090b0a;
  --card: #151815;
  --muted: #b7bdb5;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--black);
  color: white;
}
header {
  background: #101310;
  border-bottom: 2px solid var(--green);
  padding: 20px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}
.logo { font-size: 25px; font-weight: 900; }
.logo span { color: var(--green); }
header a { color: white; text-decoration: none; }
.hero {
  padding: 75px 6%;
  min-height: 330px;
  background: linear-gradient(90deg,#090b0aee,#090b0a88),
  url('https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1500&q=85') center/cover;
}
.hero h1 { font-size: clamp(35px,7vw,65px); margin: 0 0 15px; }
.hero h1 span { color: var(--green); }
.hero p { color: #ddd; font-size: 18px; }
.btn {
  display: inline-block;
  background: var(--green);
  color: #080a08;
  padding: 13px 20px;
  font-weight: bold;
  text-decoration: none;
  border: 0;
  border-radius: 5px;
  cursor: pointer;
}
main { padding: 35px 5%; }
.section-title {
  font-size: 27px;
  border-right: 4px solid var(--green);
  padding-right: 12px;
  margin-bottom: 22px;
}
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 25px;
}
input, select {
  background: #171a17;
  border: 1px solid #393e38;
  color: white;
  border-radius: 5px;
  padding: 13px;
  font-size: 15px;
  min-width: 150px;
  flex: 1;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
  gap: 22px;
}
.card {
  background: var(--card);
  border: 1px solid #292e28;
  border-radius: 9px;
  overflow: hidden;
  transition: .2s;
}
.card:hover {
  border-color: var(--green);
  transform: translateY(-4px);
}
.card img {
  width: 100%;
  height: 195px;
  object-fit: cover;
  background: #222;
}
.card-body { padding: 17px; }
.card h3 { margin: 0 0 12px; font-size: 21px; }
.specs { color: var(--muted); line-height: 1.9; font-size: 14px; }
.price { color: var(--green); font-size: 23px; font-weight: bold; margin: 12px 0; }
.euro { color: #ccc; font-size: 14px; }
.card .btn { width: 100%; text-align: center; margin-top: 8px; }
footer {
  text-align: center;
  padding: 28px 15px;
  border-top: 1px solid #30352e;
  color: #aaa;
}
.whatsapp {
  position: fixed;
  bottom: 18px;
  left: 18px;
  background: #25d366;
  color: white;
  border-radius: 50px;
  padding: 15px;
  text-decoration: none;
  font-weight: bold;
  z-index: 5;
}
</style>
</head>
<body>

<header>
  <div class="logo">ELITE <span>MOTORS</span></div>
  <a href="#motos">🏍️ اكتشف الموتورات</a>
</header>

<section class="hero">
  <h1>قوّة. سرعة. <span>تميّز.</span></h1>
  <p>اكتشف عالم الدراجات النارية الرياضية مع ELITE MOTORS.</p>
  <a href="#motos" class="btn">اكتشف مجموعتنا ←</a>
</section>

<main id="motos">
  <h2 class="section-title">الدراجات النارية</h2>

  <div class="filters">
    <input id="search" placeholder="🔍 قلّب بالاسم أو الموديل...">
    <select id="brand">
      <option value="">كل الماركات</option>
      <option>Kawasaki</option>
      <option>Yamaha</option>
      <option>BMW</option>
      <option>Honda</option>
      <option>Suzuki</option>
    </select>
    <select id="sort">
      <option value="">ترتيب الأسعار</option>
      <option value="asc">الأرخص أولاً</option>
      <option value="desc">الأغلى أولاً</option>
    </select>
  </div>

  <div class="grid" id="motorGrid"></div>
  <p id="empty" style="display:none;text-align:center;color:#bbb">
    ما لقيناش موتور بالمواصفات هاذي.
  </p>
</main>

<footer>
  <h3>ELITE <span style="color:#b7ff00">MOTORS</span></h3>
  <p>شغف الدراجات النارية يبدأ من هنا 🏁</p>
  <p>الأسعار المعروضة أمثلة قابلة للتعديل وليست عروض بيع مؤكدة.</p>
  <p>© 2026 ELITE MOTORS</p>
</footer>

<a class="whatsapp" id="whatsapp" href="#" target="_blank">
  WhatsApp ✆
</a>

<script>
const motors = [
 {
  brand:"Kawasaki", name:"Ninja ZX-10R", year:2024,
  cc:998, hp:203, price:65000,
  img:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة رياضية قوية بمحرك 4 أسطوانات."
 },
 {
  brand:"Kawasaki", name:"Ninja ZX-6R", year:2024,
  cc:636, hp:127, price:42000,
  img:"https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة رياضية متوسطة السعة لعشاق السرعة."
 },
 {
  brand:"Kawasaki", name:"Z900", year:2024,
  cc:948, hp:125, price:39000,
  img:"https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة Naked بتصميم هجومي."
 },
 {
  brand:"Yamaha", name:"YZF-R1", year:2024,
  cc:998, hp:200, price:62000,
  img:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة رياضية مستوحاة من عالم السباقات."
 },
 {
  brand:"Yamaha", name:"YZF-R7", year:2024,
  cc:689, hp:73, price:37000,
  img:"https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=900&q=85",
  desc:"تصميم رياضي بمحرك ثنائي الأسطوانات."
 },
 {
  brand:"BMW", name:"S 1000 RR", year:2024,
  cc:999, hp:210, price:78000,
  img:"https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة سوبر سبورت بتكنولوجيا متطورة."
 },
 {
  brand:"Honda", name:"CBR1000RR-R", year:2024,
  cc:1000, hp:217, price:75000,
  img:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=900&q=85",
  desc:"دراجة رياضية رائدة من هوندا."
 },
 {
  brand:"Suzuki", name:"GSX-R1000", year:2024,
  cc:999, hp:202, price:58000,
  img:"https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=900&q=85",
  desc:"أداء رياضي وتصميم انسيابي."
 }
];

// بدّل الرقم هذا برقم واتساب متاعك مع مفتاح تونس 216
// مثال: 21612345678
const PHONE = "21600000000";

function render() {
 const query = document.getElementById("search").value.toLowerCase();
 const brand = document.getElementById("brand").value;
 const sort = document.getElementById("sort").value;

 let list = motors.filter(m =>
   (m.name.toLowerCase().includes(query) ||
    m.brand.toLowerCase().includes(query)) &&
   (!brand || m.brand === brand)
 );

 if(sort === "asc") list.sort((a,b)=>a.price-b.price);
 if(sort === "desc") list.sort((a,b)=>b.price-a.price);

 document.getElementById("empty").style.display =
   list.length ? "none" : "block";

 document.getElementById("motorGrid").innerHTML = list.map(m => `
  <article class="card">
   <img src="${m.img}" alt="${m.brand} ${m.name}"
    loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/600x400/151815/b7ff00?text=ELITE+MOTORS'">
   <div class="card-body">
    <h3>${m.brand} ${m.name}</h3>
    <div class="specs">
      📅 السنة: ${m.year}<br>
      ⚙️ سعة المحرك: ${m.cc} cc<br>
      🏁 القوة: ${m.hp} حصان<br>
      📝 ${m.desc}
    </div>
    <div class="price">${m.price.toLocaleString("fr-FR")} TND</div>
    <div class="euro">حوالي ${(m.price/3.4).toLocaleString("fr-FR",{maximumFractionDigits:0})} €</div>
    <a class="btn" target="_blank"
      href="https://wa.me/${PHONE}?text=${encodeURIComponent('السلام عليكم، نحب نستفسر على '+m.brand+' '+m.name+' وسومها.')}"
    >استفسر على الموتور</a>
   </div>
  </article>
 `).join("");
}

document.getElementById("search").addEventListener("input",render);
document.getElementById("brand").addEventListener("change",render);
document.getElementById("sort").addEventListener("change",render);

document.getElementById("whatsapp").href =
 "https://wa.me/" + PHONE + "?text=" +
 encodeURIComponent("السلام عليكم، نحب نستفسر على الموتورات المتوفرة.");

render();
</script>
</body>
</html>
